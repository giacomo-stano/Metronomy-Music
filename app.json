{
  "expo": {
    "name": "Metronomy",
    "slug": "metronomy",
    "version": "0.2.2",
    "orientation": "portrait",
    "icon": "./assets/metronomy-icon-v2.png",
    "userInterfaceStyle": "automatic",
    "plugins": [["expo-audio", { "enableBackgroundPlayback": true }], "./plugins/withPreciseAudioTiming"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/metronomy-icon-v2.png"
    }
  }
}
